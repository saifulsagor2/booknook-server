# Replace placeholders in a private .env file or the deployment host's settings.
PORT=8000
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/?retryWrites=true&w=majority&appName=BookNook
MONGODB_DB_NAME=booknook
CLIENT_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Optional: configure both values only when enabling Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
